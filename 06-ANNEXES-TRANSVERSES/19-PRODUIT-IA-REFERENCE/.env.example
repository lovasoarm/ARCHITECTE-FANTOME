# Modèle volontairement invalide : le serveur le rejette. Générez un secret local avec : openssl rand -hex 32
# Ne copiez pas de valeur d’exemple dans un environnement exposé.
API_TOKEN=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
# L'identité tenant est liée à la configuration serveur/au credential, jamais au JSON de la requête.
API_TENANT_ID=demo
HOST=127.0.0.1
PORT=8080
MAX_BODY_BYTES=16384
MAX_QUESTION_CHARS=2000
RATE_LIMIT_REQUESTS=120
MAX_IN_FLIGHT=32
# Optionnel : provider compatible OpenAI. HTTPS recommandé ; voir 04-SECURITY.md.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=8000
LLM_MAX_RESPONSE_BYTES=1000000
